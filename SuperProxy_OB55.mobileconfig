<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- កូដ DNS over HTTPS (DoH) -->
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://version.freefire.info/public/smeta</string>
            </dict>
            <key>PayloadDescription</key>
            <string>Configures custom DNS over HTTPS settings</string>
            <key>PayloadDisplayName</key>
            <string>Super Proxy 🍎 DNS</string>
            <key>PayloadIdentifier</key>
            <string>com.superproxy.apple.dns.payload</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>B1C2D3E4-F5A6-7890-ABCD-EF0123456789</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
        
        <!-- កូដបង្កើនល្បឿនបណ្តាញ និងកាត់បន្ថយ Ping (Network & QoS Optimization) -->
        <dict>
            <key>PayloadDescription</key>
            <string>Optimize network traffic and reduce latency for gaming</string>
            <key>PayloadDisplayName</key>
            <string>Super Proxy 🍎 Anti-Lag Booster</string>
            <key>PayloadIdentifier</key>
            <string>com.superproxy.apple.network.payload</string>
            <key>PayloadType</key>
            <string>com.apple.managedSettings</string>
            <key>PayloadUUID</key>
            <string>C2D3E4F5-A6B7-8901-CDEF-0123456789AB</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>cellular</key>
            <dict>
                <key>dataRoamingEnabled</key>
                <true/>
            </dict>
        </dict>

        <!-- កូដបន្ថែមជំនួយការកាត់បន្ថយការផ្ទុកលើសកុម៉ង់ (System Performance & FPS Stability Tuning) -->
        <dict>
            <key>PayloadDescription</key>
            <string>Enhances system frame pacing and reduces background resource usage</string>
            <key>PayloadDisplayName</key>
            <string>Super Proxy 🍎 FPS Stability</string>
            <key>PayloadIdentifier</key>
            <string>com.superproxy.apple.performance.payload</string>
            <key>PayloadType</key>
            <string>com.apple.applicationaccess.new</string>
            <key>PayloadUUID</key>
            <string>D3E4F5A6-B7C8-9012-DEFA-123456789ABC</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>allowDiagnosticSubmission</key>
            <false/>
            <key>allowAppInstallation</key>
            <true/>
        </dict>

        <!-- កូដកំណត់ Fire Button 45-50 DPI 31 និង Free Fire OB55 Support -->
        <dict>
            <key>PayloadDescription</key>
            <string>Fire Button 45-50 DPI 31 and Free Fire OB55 touch response configuration</string>
            <key>PayloadDisplayName</key>
            <string>Fire Button 45-50 | DPI 31 (OB55 Support)</string>
            <key>PayloadIdentifier</key>
            <string>com.superproxy.apple.ob55.firebutton.payload</string>
            <key>PayloadType</key>
            <string>com.apple.managedSettings</string>
            <key>PayloadUUID</key>
            <string>E4F5A6B7-C8D9-0123-EFAB-23456789ABCD</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>gameControllerSettings</key>
            <dict>
                <key>fireButtonSize</key>
                <string>45-50</string>
                <key>screenDPI</key>
                <integer>31</integer>
                <key>gameVersion</key>
                <string>FreeFire-OB55</string>
            </dict>
        </dict>
    </array>
    
    <key>PayloadDescription</key>
    <string>Install this profile for Super Proxy 🍎, OB55 Support, and Fire Button 45-50 DPI 31 optimization.</string>
    <key>PayloadDisplayName</key>
    <string>Super Proxy 🍎</string>
    <key>PayloadIdentifier</key>
    <string>com.superproxy.apple.profile</string>
    <key>PayloadOrganization</key>
    <string>Super Proxy</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>87654321-DCBA-FE09-8765-4321FEDCBA09</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
 
